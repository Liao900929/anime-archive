# ── Binance Futures (optional for public endpoints) ──────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get token from @BotFather, chat_id from @userinfobot or the getUpdates API
TELEGRAM_BOT_TOKEN=123456789:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=-100123456789

# ── Monitor ───────────────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
MONITOR_INTERVAL=60           # seconds between each data collection cycle

# ── Alert thresholds ──────────────────────────────────────────────────────────
# Positive threshold (decimal): funding_rate > this → SHORT signal (0.03 = 3%)
FUNDING_RATE_THRESHOLD=0.03
# Negative threshold (decimal): funding_rate < this → LONG signal (-0.03 = -3%)
NEGATIVE_FUNDING_RATE_THRESHOLD=-0.03
# OI change fraction (0.05 = 5%)
OPEN_INTEREST_CHANGE_THRESHOLD=0.05
# Minimum minutes between consecutive alerts for the same condition
ALERT_COOLDOWN_MINUTES=30

# ── HTTP / Network ────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF=2.0

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_MAX_RECONNECT_DELAY=60.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=btc_monitor.log
